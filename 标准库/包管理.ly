# 高级包管理函数
定义 批量安装包 为 (包列表) -> {
    定义 结果 为 []
    对于每个 包名 在 包列表 中 {
        定义 安装结果 为 安装包(包名)
        结果 := 结果 + [安装结果]
    }
    返回 结果
}

定义 批量卸载包 为 (包列表) -> {
    定义 结果 为 []
    对于每个 包名 在 包列表 中 {
        定义 卸载结果 为 卸载包(包名)
        结果 := 结果 + [卸载结果]
    }
    返回 结果
}

定义 完整项目设置 为 (项目名, 依赖列表) -> {
    # 初始化项目
    定义 初始化结果 为 初始化项目(项目名)
    输出(初始化结果)
    
    # 安装依赖
    定义 安装结果 为 批量安装包(依赖列表)
    对于每个 结果 在 安装结果 中 {
        输出(结果)
    }
    
    # 验证配置
    定义 验证结果 为 验证包配置()
    输出(验证结果)
    
    返回 "项目设置完成"
}

# 包管理辅助函数
定义 是否已安装包 为 (包名) -> {
    定义 包列表 为 列出已安装包()
    # 简单的字符串匹配检查
    返回 字符串包含(包列表, 包名)
}

定义 安全安装包 为 (包名) -> {
    如果 是否已安装包(包名) 则 {
        返回 "包已安装: " + 包名
    } 否则 {
        返回 安装包(包名)
    }
}

定义 包管理状态报告 为 () -> {
    输出("=== 骆言包管理状态报告 ===")
    输出("")
    
    输出("已安装的包:")
    定义 包列表 为 列出已安装包()
    输出(包列表)
    输出("")
    
    输出("缓存状态:")
    定义 缓存状态 为 查看缓存状态()
    输出(缓存状态)
    输出("")
    
    输出("包配置验证:")
    定义 配置状态 为 验证包配置()
    输出(配置状态)
    
    输出("=== 报告完成 ===")
}

